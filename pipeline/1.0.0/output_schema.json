{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/agents-market/spec/blob/main/pipeline/1.0.0/output_schema.json",
  "title": "StageOutputSchema",
  "description": "Meta-schema for the per-stage output_schema subset (PIPELINE_SPEC.md §20). Only the listed keywords are allowed; anything else (e.g. $ref, allOf, anyOf, oneOf, not) fails validation. See PIPELINE_SPEC.md §20.1.",
  "definitions": {
    "schemaSubset": {
      "type": "object",
      "properties": {
        "type": {
          "anyOf": [
            {
              "type": "string",
              "enum": ["string", "number", "integer", "boolean", "array", "object", "null"]
            },
            {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "enum": ["string", "number", "integer", "boolean", "array", "object", "null"]
              }
            }
          ]
        },
        "properties": {
          "type": "object",
          "additionalProperties": { "$ref": "#/definitions/schemaSubset" }
        },
        "required": {
          "type": "array",
          "items": { "type": "string" }
        },
        "additionalProperties": {
          "anyOf": [
            { "type": "boolean" },
            { "$ref": "#/definitions/schemaSubset" }
          ]
        },
        "enum": { "type": "array" },
        "items": { "$ref": "#/definitions/schemaSubset" },
        "minItems": { "type": "integer", "minimum": 0 },
        "maxItems": { "type": "integer", "minimum": 0 },
        "minLength": { "type": "integer", "minimum": 0 },
        "maxLength": { "type": "integer", "minimum": 0 },
        "pattern": { "type": "string" },
        "format": { "type": "string" },
        "minimum": { "type": "number" },
        "maximum": { "type": "number" },
        "description": { "type": "string" }
      },
      "additionalProperties": false
    }
  },
  "$ref": "#/definitions/schemaSubset"
}
